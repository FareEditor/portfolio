{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fareeditor-content",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"workers_dev": false,
	// Только /data/*: /api/* принадлежит Worker'у контакт-формы (worker/).
	"routes": [
		{
			"pattern": "fareeditor.com/data/*",
			"zone_name": "fareeditor.com"
		}
	],
	// Сколько секунд ответ живёт в Cache API на edge. Браузеру всегда max-age=0.
	"vars": {
		"EDGE_TTL_SECONDS": 60
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fareeditor-content",
			"database_id": "f8a1d6a2-c190-49db-8df5-72d4801abe8b",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
